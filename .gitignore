# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal source material, kept local
# The resume PDF carries a phone number, so it must never reach a public repo.
# Site assets under /public are intentionally NOT ignored: the build needs them.
/*.pdf
/P-5.jpeg
/Abhay_Resume_SDE*.pdf
/Profile-Image.jpeg
